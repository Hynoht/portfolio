/manifest.webmanifest
  Content-Type: application/manifest+json; charset=utf-8
  Cache-Control: public, max-age=86400

/blind42.sh
  Cache-Control: no-cache
  X-Robots-Tag: noindex
  Content-Type: text/plain

/llms.txt
