{
  "name": "arthinez-portfolio",
  "version": "1.0.0",
  "description": "Portfolio de Tolotra Anthony RANDRIAMBOLOLONA (Arthinez) — développeur full-stack",
  "scripts": {
    "pages": "python3 scripts/build_site.py",
    "minify:css": "cleancss -o css/styles.min.css css/styles.css",
    "minify:js": "terser css/script.js -o css/script.min.js -c -m",
    "minify": "npm run minify:css && npm run minify:js",
    "build": "npm run minify",
    "dev": "npm run pages && python3 -m http.server 8000"
  },
  "devDependencies": {
    "clean-css-cli": "^5.6.3",
    "terser": "^5.27.0"
  },
  "keywords": [
    "portfolio",
    "42-Antananarivo",
    "full-stack",
    "devops"
  ],
  "author": "RANDRIAMBOLOLONA Tolotra Anthony",
  "license": "MIT"
}
